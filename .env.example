# Copy to .env and edit. Every setting is optional; these are the defaults.

# Chat model: "ollama" (local) or "openrouter" (hosted, needs a key)
PATHAKAM_LLM_PROVIDER=ollama
PATHAKAM_LLM_MODEL=gemma3:4b
# For OpenRouter, for example:
# PATHAKAM_LLM_PROVIDER=openrouter
# PATHAKAM_LLM_MODEL=google/gemma-3-27b-it
# PATHAKAM_OPENROUTER_API_KEY=sk-or-...

# Embeddings: "ollama" (bge-m3 is multilingual and handles Telugu) or "none" (keyword search only)
PATHAKAM_EMBED_PROVIDER=ollama
PATHAKAM_EMBED_MODEL=bge-m3

PATHAKAM_OLLAMA_URL=http://127.0.0.1:11434
PATHAKAM_TOP_K=6
